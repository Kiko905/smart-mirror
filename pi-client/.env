SMART_MIRROR_MODE=mock

API_BASE_URL=http://192.168.100.11:8000
API_TIMEOUT_SECONDS=10

MOCK_RECOGNIZED_USER_ID=1
MOCK_RECOGNIZED_USER_NAME=Test User
FACE_CAMERA_INDEX=0
FACE_DISTANCE_THRESHOLD=0.5

VOICE_ENABLED=true
VOICE_MODE=mock
VOICE_MOCK_INPUT=show my layout

FACE_LAST_USER_FILE=/home/pi/smart-mirror/pi-client/face/last_user.txt
LAYOUT_OUTPUT_FILE=/home/pi/smart-mirror/pi-client/mirror/current_layout.json
PROFILE_OUTPUT_FILE=/home/pi/smart-mirror/pi-client/mirror/current_profile.json

MAGICMIRROR_RESTART=true
MAGICMIRROR_RESTART_CMD=pm2 restart magicmirror
